{
    "info": {
        "name": "Mock Premium API",
        "description": "Static mock API hosted on GitHub Pages. All endpoints are GET-only and return fixed JSON responses. Base URL: {{baseUrl}}",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "https://sreekarkandala.github.io/mock-premium-api",
            "type": "string"
        }
    ],
    "event": [
        {
            "listen": "test",
            "script": {
                "type": "text/javascript",
                "exec": [
                    "pm.test(\"Status is 200\", function () {",
                    "    pm.response.to.have.status(200);",
                    "});",
                    "pm.test(\"Body is valid JSON\", function () {",
                    "    pm.response.json();",
                    "});"
                ]
            }
        }
    ],
    "item": [
        {
            "name": "Data Sync",
            "item": [
                {
                    "name": "Explore Product table",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/data-sync/api/v1/db/explore/Product",
                            "host": ["{{baseUrl}}"],
                            "path": ["data-sync", "api", "v1", "db", "explore", "Product"]
                        },
                        "description": "Table metadata for the Product table: columns, child relations, row and column counts. Extensionless path matching the real API; served as application/octet-stream but the body is JSON."
                    },
                    "response": []
                },
                {
                    "name": "Explore Product table (.json twin)",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/data-sync/api/v1/db/explore/Product.json",
                            "host": ["{{baseUrl}}"],
                            "path": ["data-sync", "api", "v1", "db", "explore", "Product.json"]
                        },
                        "description": "Identical payload to the extensionless endpoint, served with Content-Type: application/json."
                    },
                    "response": []
                }
            ]
        },
